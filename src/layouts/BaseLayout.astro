---
import '../styles/global.css'
import { site } from '../site'
import TopBar from '../components/layout/TopBar.astro'
import FooterBar from '../components/layout/FooterBar.astro'

type Props = {
  title: string
  description?: string
  image?: string
  keywords?: string[]
  index?: boolean
}

const {
  title,
  description = site.metaDescription,
  image = '/assets/og.png',
  keywords = [],
  index = false,
} = Astro.props

const metaTitle = index ? `${site.title} | ${site.shortDescription}` : title
const metaImage = /^https?:\/\//.test(image)
  ? image
  : image.startsWith('/assets/')
    ? `${site.siteUrl}${image}`
    : `${site.imageHost}/${image}`

const path = Astro.url.pathname
const canonicalUrl = new URL(path.endsWith('/') ? path : `${path}/`, site.siteUrl).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.siteName} />
    {site.facebookAppId && <meta property="fb:app_id" content={site.facebookAppId} />}
    <meta property="og:image" content={metaImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={site.author} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="aivan.io RSS Feed" href="/rss.xml" />
    <script is:inline>
      /* theme init — runs before first paint so an OS-dark visitor never sees
         a light flash. Saved choice wins; otherwise follow the OS. */
      ;(function () {
        var t = null
        try {
          t = localStorage.getItem('aivan:theme')
        } catch (e) {
          /* private mode */
        }
        if (t !== 'dark' && t !== 'light') {
          t =
            window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
        }
        document.documentElement.setAttribute('data-theme', t)
      })()
    </script>
    <script is:inline>
      /* route entry — runs before first paint. Only a navigation the reader
         initiated gets movement: a link click on this site leaves a marker,
         and back/forward, reload and cold visits stay instant. */
      ;(function () {
        var t = 0
        try {
          t = +sessionStorage.getItem('aivan:nav') || 0
          sessionStorage.removeItem('aivan:nav')
        } catch (e) {
          return
        }
        if (!t || Date.now() - t > 4000) return
        var nav =
          performance.getEntriesByType && performance.getEntriesByType('navigation')[0]
        if (nav && nav.type !== 'navigate') return
        document.documentElement.setAttribute('data-enter', 'set')
        setTimeout(function () {
          if (document.documentElement.getAttribute('data-enter') === 'set') {
            document.documentElement.setAttribute('data-enter', 'play')
          }
        }, 700)
      })()
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(registrations => {
          registrations.forEach(registration => registration.unregister())
        })
      }
    </script>
    <script is:inline>
      const dnt =
        navigator.doNotTrack === '1' ||
        window.doNotTrack === '1' ||
        navigator.msDoNotTrack === '1'
      const localHost =
        location.hostname === 'localhost' ||
        location.hostname === '127.0.0.1' ||
        location.hostname === '[::1]'

      if (!dnt && !localHost) {
        window.dataLayer = window.dataLayer || []
        function gtag() {
          dataLayer.push(arguments)
        }
        gtag('js', new Date())
        gtag('config', 'G-2S179EH3RR', {
          anonymize_ip: true,
          cookie_expires: 0,
        })

        function loadAnalytics() {
          const gtagScript = document.createElement('script')
          gtagScript.async = true
          gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-2S179EH3RR'
          document.head.appendChild(gtagScript)
        }

        window.addEventListener(
          'load',
          function () {
            if ('requestIdleCallback' in window) {
              window.requestIdleCallback(loadAnalytics, { timeout: 3000 })
            } else {
              setTimeout(loadAnalytics, 0)
            }
          },
          { once: true }
        )
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main" id="skip">Skip to content</a>
    <TopBar path={path} />
    <main id="main" tabindex="-1">
      <div class="wrap" id="page-content">
        <div class="g">
          <slot />
        </div>
      </div>
      <div class="wrap" id="search-live" hidden>
        <div class="g" id="search-results-head"></div>
        <div class="g" id="search-results-live"></div>
      </div>
    </main>
    <FooterBar />
    <div id="announcer" class="vh" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/search'
      import '../scripts/ui-craft'
    </script>
  </body>
</html>
