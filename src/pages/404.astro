---
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  formatRailDate,
  getPostPath,
  getReadingTime,
  getSortedPosts,
} from '../lib/posts'

const posts = (await getSortedPosts()).slice(0, 3)
---

<BaseLayout
  title="404: Page not found"
  description="The page you requested could not be found on aivan.io."
>
  <div class="row rowt">
    <div class="gl hd"><h1 class="term">not found</h1></div>
    <div class="gr hd">
      <p class="def">That URL does not map to anything here.</p>
      <p class="sum">
        Every published entry is reachable from <a href="/">home</a> — or search
        with <code>/</code>. The feed lives at <a href="/rss.xml">rss</a>.
      </p>
    </div>
  </div>

  <div class="row rowt">
    <div class="gl sp"><h2 class="slab">recent posts</h2></div>
    <div class="gr sp"><a class="all" href="/">all posts</a></div>
  </div>

  {
    posts.map(post => (
      <div class="row">
        <div class="gl ent">
          <span class="rl">{formatRailDate(post.data.date)}</span>
          <span class="rl">
            {post.data.category} · {getReadingTime(post)}
          </span>
        </div>
        <div class="gr ent">
          <p class="etitle">
            <a href={getPostPath(post)}>{post.data.title}</a>
          </p>
          <p class="sum">{post.data.meta_description}</p>
        </div>
      </div>
    ))
  }
</BaseLayout>
