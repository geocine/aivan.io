---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroDossier from '../components/home/HeroDossier.astro'
import PostLedger from '../components/home/PostLedger.astro'
import { getSortedPosts } from '../lib/posts'

const posts = await getSortedPosts()
---

<BaseLayout title="Aivan Monceller" index keywords={['aivan monceller', 'programming']}>
  <HeroDossier />
  <PostLedger posts={posts} />
</BaseLayout>
