<script>
  import '../scripts/toc'

  /* the pinned rail carries a live "you are here": when a section slab
     scrolls under the paper-backed identity box, its name docks below the
     identity — same replacement behaviour as the post pages' section mark */
  const dock = document.getElementById('railpin-sec')
  const box = dock?.closest('.railpin-box')
  const slabs = [...document.querySelectorAll('.g .gl.sp .slab')] as HTMLElement[]
  if (dock && box && slabs.length > 0) {
    let ticking = false
    const update = () => {
      ticking = false
      /* the dock line always occupies space (nbsp when empty), so the box
         height — and with it this threshold — never depends on the dock's
         own content; a growing box would otherwise stale the check */
      const limit = box.getBoundingClientRect().bottom
      let current = ''
      for (const slab of slabs) {
        if (slab.getBoundingClientRect().top < limit) current = slab.textContent ?? ''
      }
      dock.textContent = current === '' ? '\u00A0' : current
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(update)
        }
      },
      { passive: true }
    )
    update()
  }
</script>
